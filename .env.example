# Son of Anton — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Service authentication (SECURITY)
# ---------------------------------------------------------------------------
# Shared bearer token for every inter-service HTTP call. All backend services
# refuse to start unless this is set, and reject unauthenticated requests
# (except /health and /metrics). The value below is an INSECURE dev placeholder
# so `cp .env.example .env && docker compose up` works out of the box — replace
# it with a strong random value for any shared or production use, e.g.:
#   openssl rand -hex 32
SOTA_SERVICE_TOKEN=dev-insecure-service-token-change-me

# Datastore credentials. When set, FalkorDB requires this password and Qdrant
# requires this API key on its data endpoints. Leave empty for a password-less
# local dev stack (services and clients then connect without auth).
FALKORDB_PASSWORD=
QDRANT_API_KEY=

# background-tasks controls the Docker daemon, so it uses its own dedicated
# bearer token (separate from SOTA_SERVICE_TOKEN) and refuses to start without
# it. BACKGROUND_TASK_ALLOWED_IMAGES is a comma-separated allowlist of extra
# container images permitted for tasks (beyond the built-in
# soa-background-agent:latest).
BACKGROUND_TASK_API_TOKEN=dev-insecure-background-token-change-me
BACKGROUND_TASK_ALLOWED_IMAGES=

# FalkorDB
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# Qdrant
QDRANT_HOST=qdrant
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Indexer
PROJECT_PATH=/workspace
LANGUAGES=typescript,python,rust,csharp,cpp

# MCP Gateway (Code Graph)
MCP_PORT=3100

# MCP Database Server
DB_HOST=postgres
DB_PORT=5432
DB_NAME=son_of_anton
DB_USER=readonly
DB_PASSWORD=

# MCP Deployment & Tickets Servers
GITHUB_REPOSITORY=CodeHalwell/Son-Of-Anton
GITHUB_TOKEN=

# LLM
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model Router
MODEL_ROUTER_PORT=3200
MODEL_ROUTER_URL=http://model-router:3200

# Workspace Checkpoints
CHECKPOINT_PORT=3201

# Walkthrough Generator
WALKTHROUGH_PORT=3202

# ---------------------------------------------------------------------------
# Additional service ports
# ---------------------------------------------------------------------------
# Host bindings for every published port are 127.0.0.1-only (see
# docker-compose.yml); these override the in-container defaults.
ACP_PORT=3300
BUILD_DAG_PORT=3301
SANITISER_PORT=3302
SPEC_PIPELINE_PORT=8090
PEN_TEST_PORT=8092
BACKGROUND_TASKS_PORT=8093
VISUAL_REGRESSION_PORT=8094
MCP_DATABASE_PORT=3102
MCP_DEPLOYMENT_PORT=3103
MCP_TICKETS_PORT=3104
MCP_PLAYWRIGHT_PORT=3105

# ACP client agent registry (path inside the workspace mount)
ACP_CONFIG_PATH=/workspace/.son-of-anton/agents/acp-agents.json

# Penetration tester → OWASP ZAP (ZAP runs on the internal sandbox network;
# ZAP_PORT is the port ZAP listens on inside its container, not a host port).
ZAP_HOST=owasp-zap
ZAP_PORT=8090
TARGET_BASE_URL=http://localhost:3000

# Comma-separated origins the Playwright MCP server is allowed to navigate to.
ALLOWED_ORIGINS=localhost,127.0.0.1

# Cross-service tracing (optional)
# Enable Jaeger: docker compose --profile tracing up -d
# Then uncomment and set the endpoint below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# JAEGER_UI_PORT=16686
# JAEGER_OTLP_PORT=4318
