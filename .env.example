# Son of Anton — Environment Configuration
# Generate a private local configuration (does not overwrite an existing .env):
#   node scripts/configure-services.mjs
# Then fill in optional provider settings below. Never commit .env.

# Shared HTTP bearer token and independent datastore/task credentials.
# The setup command generates a different random secret for each field.
# Empty values intentionally prevent Compose from starting the service stack.
SOTA_SERVICE_TOKEN=
FALKORDB_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
QDRANT_API_KEY=
BACKGROUND_TASK_API_TOKEN=
BACKGROUND_TASK_ALLOWED_IMAGES=

# FalkorDB
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# Qdrant
QDRANT_HOST=qdrant
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Indexer. PROJECT_PATH is the HOST directory to index; Docker bind-mounts it at
# /workspace inside every service (the fixed in-container scan root). "." indexes
# this repo — point it at another project's path to index that instead. Do NOT
# set it to /workspace (that mounts the host's /workspace, not your project).
PROJECT_PATH=.
LANGUAGES=typescript,tsx,javascript,python

# MCP Gateway (Code Graph)
MCP_PORT=3100

# MCP Database Server
DB_HOST=postgres
DB_PORT=5432
DB_NAME=son_of_anton
DB_USER=readonly
DB_PASSWORD=

# MCP Deployment & Tickets Servers
GITHUB_REPOSITORY=CodeHalwell/Son-Of-Anton
GITHUB_TOKEN=

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Semantic search embeddings (indexer + mcp-gateway — both read the SAME
# variables; documents and queries must be embedded by the same model).
#
#   mock   — deterministic pseudo-vectors, no network. Dev/test only:
#            semantic search "works" but relevance is meaningless.
#   voyage — Voyage AI (recommended for code). Set EMBEDDING_API_KEY (or
#            VOYAGE_API_KEY) and QDRANT_VECTOR_SIZE to a supported output
#            dimension of the model (voyage-code-3: 256/512/1024/2048).
#   openai — OpenAI embeddings. Set EMBEDDING_API_KEY (or OPENAI_API_KEY).
#   local  — any OpenAI-compatible endpoint (Ollama, TEI, LM Studio, vLLM).
#            Set EMBEDDING_ENDPOINT to the full embeddings URL and
#            EMBEDDING_MODEL to the served model.
#
# Changing provider, model, or vector size invalidates the Qdrant collection —
# re-run the indexer afterwards.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=
# QDRANT_VECTOR_SIZE=768
# Example (Voyage): EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-code-3,
#                   EMBEDDING_API_KEY=pa-..., QDRANT_VECTOR_SIZE=1024
# Example (Ollama): EMBEDDING_PROVIDER=local, EMBEDDING_MODEL=nomic-embed-text,
#                   EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1/embeddings,
#                   QDRANT_VECTOR_SIZE=768

# Session spend kill switch for the headless CLI (`sota run`). Opt-in: set any
# of these to a positive number to cap a session's spend and halt the agent
# loop once a cap is reached. Unset = uncapped (default). The IDE uses the
# `sota.spendLimit.*` settings instead.
# SOTA_SESSION_MAX_COST_USD=5
# SOTA_SESSION_MAX_TOKENS=2000000
# SOTA_SESSION_MAX_REQUESTS=200

# Model Router
MODEL_ROUTER_PORT=3200
MODEL_ROUTER_URL=http://model-router:3200

# Workspace Checkpoints
CHECKPOINT_PORT=3201

# Walkthrough Generator
WALKTHROUGH_PORT=3202

# ---------------------------------------------------------------------------
# Additional service ports
# ---------------------------------------------------------------------------
# Host bindings for every published port are 127.0.0.1-only (see
# docker-compose.yml); these override the in-container defaults.
ACP_PORT=3300
ACP_MAX_PROCESSES=4
ACP_MAX_QUEUE=32
BUILD_DAG_PORT=3301
SANITISER_PORT=3302
SPEC_PIPELINE_PORT=8090
PEN_TEST_PORT=8092
BACKGROUND_TASKS_PORT=8093
VISUAL_REGRESSION_PORT=8094
MCP_DATABASE_PORT=3102
MCP_DEPLOYMENT_PORT=3103
MCP_TICKETS_PORT=3104
MCP_PLAYWRIGHT_PORT=3105

# ACP client agent registry (path inside the workspace mount)
ACP_CONFIG_PATH=/workspace/.son-of-anton/agents/acp-agents.json

# Penetration tester → OWASP ZAP (ZAP runs on the internal sandbox network;
# ZAP_PORT is the port ZAP listens on inside its container, not a host port).
ZAP_HOST=owasp-zap
ZAP_PORT=8090
TARGET_BASE_URL=http://localhost:3000

# Comma-separated origins the Playwright MCP server is allowed to navigate to.
ALLOWED_ORIGINS=localhost,127.0.0.1

# Cross-service tracing (optional)
# Enable Jaeger: docker compose --profile tracing up -d
# Then uncomment and set the endpoint below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# JAEGER_UI_PORT=16686
# JAEGER_OTLP_PORT=4318
