{
	"name": "son-of-anton-core",
	"version": "0.1.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.json && node -e \"require('fs').mkdirSync('dist/agents/prompts',{recursive:true}); for (const f of require('fs').readdirSync('src/agents/prompts')) { require('fs').copyFileSync('src/agents/prompts/'+f,'dist/agents/prompts/'+f); }\"",
		"watch": "tsc -p tsconfig.json --watch",
		"pretest": "npm run build",
		"test": "node --test \"dist/**/*.test.js\""
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "^3.700.0",
		"@aws-sdk/credential-providers": "^3.700.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"cross-spawn": "7.0.6",
		"jsonc-parser": "^3.3.1",
		"smol-toml": "^1.8.0",
		"tar": "^7.5.22",
		"yaml": "^2.9.0",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@smithy/types": "^3.0.0",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "^22.19.21",
		"@types/yauzl": "^2.10.3",
		"typescript": "^6.0.0-dev"
	}
}
