{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"ignoreDeprecations": "6.0",
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["index.ts", "test/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
